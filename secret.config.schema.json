{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secret self-host config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "portal", "edge", "limits"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "workerName"],
      "properties": {
        "ga4": {
          "type": "string",
          "description": "Optional GA4 measurement ID. Leave empty to disable analytics.",
          "pattern": "^(G-[A-Z0-9]+)?$"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "workerName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "workerName"],
      "properties": {
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "workerName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "HYBRID_MAX_TEXT_BYTES",
        "HYBRID_MAX_TEXT_CIPHER_BYTES",
        "HYBRID_MAX_FILE_MB",
        "HYBRID_MAX_FILE_CIPHER_MB",
        "HYBRID_MAX_READS",
        "HYBRID_MAX_SECRET_TTL_SECONDS",
        "CLIENT_VALID_EXPIRATIONS_SECONDS",
        "CLIENT_VALID_LINK_COUNTS",
        "API_PENDING_UPLOAD_TTL_SECONDS",
        "API_TRACKING_TTL_SECONDS",
        "API_R2_UPLOAD_URL_TTL_SECONDS"
      ],
      "properties": {
        "HYBRID_MAX_TEXT_BYTES": {
          "$ref": "#/$defs/positiveNumber"
        },
        "HYBRID_MAX_TEXT_CIPHER_BYTES": {
          "$ref": "#/$defs/positiveNumber"
        },
        "HYBRID_MAX_FILE_MB": {
          "$ref": "#/$defs/positiveNumber"
        },
        "HYBRID_MAX_FILE_CIPHER_MB": {
          "$ref": "#/$defs/positiveNumber"
        },
        "HYBRID_MAX_READS": {
          "$ref": "#/$defs/positiveNumber"
        },
        "HYBRID_MAX_SECRET_TTL_SECONDS": {
          "$ref": "#/$defs/positiveNumber"
        },
        "CLIENT_VALID_EXPIRATIONS_SECONDS": {
          "$ref": "#/$defs/positiveNumberArray"
        },
        "CLIENT_VALID_LINK_COUNTS": {
          "$ref": "#/$defs/positiveNumberArray"
        },
        "API_PENDING_UPLOAD_TTL_SECONDS": {
          "$ref": "#/$defs/positiveNumber"
        },
        "API_TRACKING_TTL_SECONDS": {
          "$ref": "#/$defs/positiveNumber"
        },
        "API_R2_UPLOAD_URL_TTL_SECONDS": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    }
  },
  "$defs": {
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "positiveNumberArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/positiveNumber"
      }
    }
  }
}
