{
  "name": "edge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "release": "pnpm --filter secret-cipher build && pnpm db:migrate && wrangler deploy --minify --secrets-file .dev.vars",
    "db:apply:local": "wrangler d1 execute secret-next --local --file schema.sql",
    "db:apply": "wrangler d1 execute secret-next --remote --file schema.sql",
    "db:migrate": "wrangler d1 migrations apply secret-next --remote",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "prettier": "@unix/prettier",
  "dependencies": {
    "hono": "^4.12.23",
    "secret-cipher": "^0.1.1",
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@unix/prettier": "^0.1.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.97.0"
  }
}
