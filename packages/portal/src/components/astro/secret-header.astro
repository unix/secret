---
import anonymousIcon from '@/assets/icons/anonymous.svg?raw'

interface Props {
  compact?: boolean
  showBrandText?: boolean
}

const { compact = false, showBrandText = true } = Astro.props
---

<nav
  aria-label="Primary"
  class:list={[
    'mx-auto flex w-full max-w-7xl items-start justify-between px-4 md:px-13',
    compact ? 'h-16 pt-4' : 'h-24 pt-7',
  ]}>
  <a
    href="/"
    aria-label="Secret home"
    class:list={[
      'flex h-9 items-center rounded-lg border border-dashed border-zinc-300 bg-white text-sm font-medium text-zinc-800 transition-colors hover:border-violet-400 hover:text-zinc-950',
      showBrandText ? 'gap-2 px-2 pr-3' : 'justify-center px-1.5',
    ]}>
    <span
      class="flex size-7 items-center justify-center rounded-md bg-zinc-100 text-zinc-950 [&_svg]:size-4.5">
      <Fragment set:html={anonymousIcon} />
    </span>
    {showBrandText && <span>Secret</span>}
  </a>
</nav>
