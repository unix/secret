---
import HeadLayout from '@/layouts/head.layout.astro'

export const prerender = true
---

<HeadLayout
  title="Secret - Not Found"
  description="This Secret page could not be found.">
  <main
    aria-labelledby="not-found-title"
    class="flex min-h-svh bg-white [background-image:radial-gradient(var(--border)_1px,transparent_1px)] [background-size:22px_22px] text-zinc-950">
    <section
      class="mx-auto flex w-full max-w-3xl flex-col items-center justify-center px-5 py-16 text-center">
      <div class="mb-6">
        <h2 class="text-lg font-medium text-zinc-950">404 NotFound</h2>
        <p class="mt-1 text-sm leading-6 text-zinc-600 sm:text-base">
          This link may be expired, already consumed.
        </p>
      </div>
      <div class="flex">
        <a
          href="/"
          draggable="false"
          class="text-sm font-medium text-zinc-600 underline decoration-zinc-400 decoration-dashed underline-offset-4 transition-colors hover:decoration-zinc-900 focus-visible:ring-2 focus-visible:ring-ring/30 focus-visible:outline-none">
          Back to Secret
        </a>
      </div>
    </section>
  </main>
</HeadLayout>
