---
import SecretFooter from '@/components/astro/secret-footer.astro'
import SecretHeader from '@/components/astro/secret-header.astro'
import SecretPageHero from '@/components/astro/secret-page-hero.astro'
import { TrackSecretIsland } from '@/islands/track.island'
import HeadLayout from '@/layouts/head.layout.astro'
---

<HeadLayout title="Secret - Tracked">
  <main class="flex min-h-svh flex-col bg-white text-black">
    <SecretHeader />
    <SecretPageHero
      title="Secret Tracked"
      description="Everything is ready, here are all your available links."
    />
    <TrackSecretIsland client:only="react" />
    <SecretFooter />
  </main>
</HeadLayout>
