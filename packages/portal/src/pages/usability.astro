---
import SecretFooter from '@/components/astro/secret-footer.astro'
import SecretHeader from '@/components/astro/secret-header.astro'
import SecretPageHero from '@/components/astro/secret-page-hero.astro'
import HeadLayout from '@/layouts/head.layout.astro'
---

<HeadLayout title="Secret - Usability">
  <main class="flex min-h-svh flex-col bg-white text-black">
    <SecretHeader />
    <SecretPageHero
      title="Usability of Secret"
      description="Operation status and donation record."
    />

    <section class="mx-auto w-full max-w-7xl px-9 md:px-18">
      <article class="post-content mx-auto max-w-[618px] pb-20">
        <p>
          <a href="/">Secret</a> is an open source project and has no commercial activities,
          I added some start-up capital to it and expect it to run for 1 year. If you feel
          this project is helpful to you, you can make a donation.
        </p>

        <section>
          <h2>Cost</h2>
          <p>
            Secret is hosted on digitalocean and costs about $10 per month, which
            includes the server, database, etc.
          </p>
        </section>

        <section>
          <h2>Donation</h2>
          <p>
            Secret receive <span class="font-medium">USDT TRC20 (TRON)</span>
            assets as donations, and all transactions are publicly accessible. The last
            few account transactions will be displayed here by default. In order to ensure
            the proper use of donated funds, the use of each expenditure will be recorded
            on the blockchain in the form of memo.
          </p>
        </section>

        <section>
          <h2>Donation address</h2>
          <p class="break-all font-mono text-sm leading-6">
            TNG2uQLBTYYS8yx427JBPgnCSvU3mMGUBB
          </p>
        </section>

        <section>
          <h2>Records</h2>
          <p class="text-sm leading-6 text-neutral-500">
            Donation records will be listed here after the public data source is
            connected.
          </p>
        </section>
      </article>
    </section>

    <SecretFooter />
  </main>
</HeadLayout>
