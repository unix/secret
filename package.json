{
  "name": "secret-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter portal dev",
    "secret-cipher": "node scripts/sync-secret-cipher-deps.mjs workspace",
    "secret-cipher:workspace": "node scripts/sync-secret-cipher-deps.mjs workspace",
    "secret-cipher:npm": "node scripts/sync-secret-cipher-deps.mjs npm",
    "release:setup": "pnpm dlx secret-self-host@latest",
    "release:edge": "pnpm --filter edge release",
    "release:portal": "pnpm --filter portal release"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/unix/secret"
  },
  "packageManager": "pnpm@11.1.3",
  "devDependencies": {
    "wrangler": "^4.97.0"
  }
}
